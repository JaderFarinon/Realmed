                            <option value="3">Todos</option>
                            <option value="1">Finalizados</option>
                            <option value="0">Não Finalizados</option>
                        </select>
                    </div>
                </div>
                }
        </div>
        <div class="offcanvas-footer">
            <div class="row mb-1">
                <div class="col-2">
                    <button type="button" class="btn w-100" @onclick=@(() => {notIncidenteFiltro = new() { DsPaciente = "", DsClass = "", CdMedico = 0, CdSetorNotificador = 0, CdIncidente = 0 }; StateHasChanged();})>&nbsp;&nbsp;&nbsp;<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-trash"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 7l16 0" /><path d="M10 11l0 6" /><path d="M14 11l0 6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg></button>
                </div>
                @if (ActivePreProcessamento == true || ActivePrePesquisa == true)
                {
                    <div class="col-10">
                        <button type="button" class="btn btn-primary w-100 " data-bs-dismiss="offcanvas" @onclick="ListarNotificacoes">Buscar</button>
                    </div>
                }
                else
                {
                    <div class="col-10">
                        <button type="button" class="btn btn-primary w-100 " data-bs-dismiss="offcanvas" @onclick="ListarNotificacoesEtapas">Buscar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Page Footer -->
<footer class="page-footer d-print-none mt-2">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <div class="btn-list">
                                @if (iePreviewProcessamento && !ieParametro && !ieProcessamento)
                                {
                                    <div class="col-lg-auto ms-lg-auto">
                                        <div class="btn-list">
                                            <a class="btn btn-warning d-none d-sm-inline-block" @onclick="@(() => {iePreviewProcessamento = false;})">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                                Voltar
                                            </a>
                                            <a class="btn btn-danger d-sm-none btn-icon" aria-label="Cancelar" @onclick="@(() => {iePreviewProcessamento = false;})">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                }
                                else if (ieProcessamento && !ieParametro && !iePreviewProcessamento)
                                {
                                    <div class="col-lg-auto ms-lg-auto">
                                        <div class="btn-list">
                                            <a class="btn btn-warning d-none d-sm-inline-block" @onclick="@(() => {ieProcessamento = false;})">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                                Voltar
                                            </a>
                                            <a class="btn btn-danger d-sm-none btn-icon" aria-label="Cancelar" @onclick="@(() => {ieProcessamento = false;})">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </a>
                                            <a class="btn btn-success d-none d-sm-inline-block" @onclick="@(() => {child.GravarPosProcessamento();})">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-plus" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <path d="M12 5l0 14"></path>
                                                    <path d="M5 12l14 0"></path>
                                                </svg>
                                                Salvar
                                            </a>
                                            <a class="btn btn-success d-sm-none btn-icon" @onclick="@(() => {child.GravarPosProcessamento();})">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-plus" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <path d="M12 5l0 14"></path>
                                                    <path d="M5 12l14 0"></path>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {

                                }
                            </div>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <div class="btn-list">
                                @if (ieBtnParametro)
                                {
                                    <a class="btn" @onclick="@(() => {ieParametro = !ieParametro; CheckPermissao(); })">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z"></path><path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path></svg>
                                        Parâmetros
                                    </a>
                                }
                                @if(!ieParametro && !ieProcessamento && !iePreviewProcessamento)
                                {
                                    <a class="btn btn-md" data-bs-toggle="offcanvas" href="#filtros" role="button" aria-controls="filtros">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-filter"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227z" /></svg>
                                        Filtros
                                    </a>
                                    <h4 class="mt-2">Total de <span> @listaNotificacoes.Count </span> resultados</h4>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

