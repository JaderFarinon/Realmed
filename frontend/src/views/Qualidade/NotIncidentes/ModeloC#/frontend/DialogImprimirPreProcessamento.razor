@page "/DialogImprimirPreProcessamento"
@page "/DialogImprimirPreProcessamento/{NotificacaoID:int}"

@layout GlobalLayout
@using Radzen
@using Radzen.Blazor
@using Microsoft.EntityFrameworkCore
@using System.Web
@using System.Threading;
@using TinyMCE.Blazor
@using NexusHealth_Blazor.Pages.Global
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Linq;
@inject ProtectedSessionStorage ProtectedSessionStore
@inject Majorsoft.Blazor.Extensions.BrowserStorage.ILocalStorageService localStorage
@inject NavigationManager Navigation
@inject TooltipService TooltipService
@inject DialogService DialogService
@inject Radzen.NotificationService NotificationService
@inject IJSRuntime JS

<style>
    .rodape {
        position: absolute;
        width: 100%;
        bottom: 0;
        display: flex;
        justify-content: space-between;
    }

    .card-footer, .footer-transparent * {
        .pagenum:before {
            content: counter(page);
        }

        .card-footer .pagenum:before {
            content: counter(page);
        }
    }
</style>

<div class="row" style="width: 100dvw; max-height: 85dvh;">
    <RadzenCard Class="rz-mx-auto text-center" Style=" overflow: hidden; overflow-x:hidden; overflow-y:hidden; margin: 10px">
        <RadzenRow RowGap="0">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Class="rz-p-2">
                <RadzenImage Path="./static/logo_cionc.png" Style="width: 150px; height: 100px;" />
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.H4" TextAlign="TextAlign.Center" class="text-nowrap" style="margin-top: 15px;"><b>Notificação de Incidente - @notificacao.Id</b></RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenRow>
         <div class="container-xl" >
                    <div class="card card-lg">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3">
                                    <img src="" class="w-50 h-50 object-cover card-img-start" alt="Beautiful blonde woman relaxing with a can of coke on a tree stump by the beach">
                                </div>
                                <div class="col justify-content-center align-content-center text-center">
                                    <h1></h1>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12">
                                    <span class="badge bg-blue w-100 text-blue-fg">Dados da Notificação</span>
                                </div>
                            </div>
                            <div class="row w-100">
                                <div class="col-3">

                                    <h3>Criado Por</h3>
                                    <p>@(notificacao.NmNotificador != "" ? notificacao.NmNotificador : "Não Informado")</p>

                                    <h3>Setor</h3>
                                    <p>@(notificacao.CdSetorNotificador != 0 && notificacao.CdSetorNotificador != 0 ? listaSetores.First(x => x.Id == notificacao.CdSetorNotificador).NmSetor : "Não Informado")</p>

                                    <h3>Paciente</h3>
                                    <p>@(notificacao.DsPaciente != null ? notificacao.DsPaciente : "Não Informado")</p>

                                </div>
                                <div class="col-4">
                                    <h3>Médico</h3>
                                    <p>@(notificacao.CdMedico != null ? listaMedicos.First(x => x.Id_profissional == notificacao.CdMedico).Nm_profissional : "Não Informado")</p>

                                    <h3>Incidente</h3>
                                    <p>@DsIncidente</p>

                                    <h3>Fato</h3>
                                    <p>@notificacao.DsFato</p>

                                </div>
                                <div class="col-4">
                                    <h3>Consequências para</h3>
                                    <p>@notificacao.DsConsequencias</p>

                                    <h3>Consequências</h3>
                                    <p>@notificacao.DsConsequenciasImediatas</p>

                                    <h3>Ações Imediatas</h3>
                                    <p>@notificacao.DsAcoesImediatas</p>

                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12">
                                    <span class="badge bg-red w-100 text-red-fg">Pré Processamento</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-3">
                                    <h3>Classificação do Incidente</h3>
                                    <p>@notificacao.DsClass</p>
                                </div>
                                <div class="col-4">
                                    <h3>Motivo da Classificação</h3>
                                    <p>@notificacao.DsMotClass</p>
                                </div>
                                <div class="col-4">
                                    <h3>Responsável pela Notificação</h3>
                                    <p>@DsResponsavel</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <footer class="footer footer-transparent">
                    <div class="rodape corpo" style="page-break-after: always;">
                        <div class="sidebyside leftfloat"><b>Usuário: </b>Diogo César Moreira de Britto</div>
                        <div class="sidebyside middlefloat">
                            <b>Página: </b><span class="pagenum"></span
                        </div>
                        <div class="sidebyside rightfloat">

                            <b>Data: </b>@DateTimeOffset.Now.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                </footer> 
    </RadzenCard>
</div>


