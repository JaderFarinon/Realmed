@page "/PreviewProcessamento/"

@using TinyMCE.Blazor
@using NexusHealth_Blazor.Pages.Global
@using NexusHealth_Blazor.Pages.Qualidade;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Linq;
@inject ProtectedSessionStorage ProtectedSessionStore
@inject Majorsoft.Blazor.Extensions.BrowserStorage.ILocalStorageService localStorage
@inject NavigationManager Navigation
@inject TooltipService TooltipService
@inject DialogService DialogService
@inject Radzen.NotificationService NotificationService
@inject ContextMenuService ContextMenuService
@layout GlobalLayout
@inject IJSRuntime JS

<style>
    .skew {
        -webkit-transform: skew(30deg);
        -ms-transform: skew(30deg);
        transform: skew(30deg); /* SKEW da div*/
    }

    .p-skew {
        padding: 2px;
        -webkit-transform: skew(-30deg);
        -ms-transform: skew(-30deg);
        transform: skew(-30deg); /* SKEW inverso para o texto não inclinar */
    }

    .skew-reverse {
        -webkit-transform: skew(-30deg);
        -ms-transform: skew(-30deg);
        transform: skew(-30deg); /* SKEW da div*/
    }

    .p-skew-reverse {
        padding: 2px;
        -webkit-transform: skew(30deg);
        -ms-transform: skew(30deg);
        transform: skew(30deg); /* SKEW inverso para o texto não inclinar */
    }
</style>

<div class="container-xl">
    <div class="row row-cards">
        <div class="col-lg-3">
            <div class="card" style="height: calc((100vh - 200px) / 2); overflow: auto;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div>
                            <h3 class="lh-1">Notificação @notificacao.Id</h3>
                        </div>
                    </div>
                    <h4>Dados da Notificação</h4>
                    <ul class="list-unstyled space-y-1">
                        <li>
                            <div class="h4 m-0">Criado por</div>
                            <div class="text-secondary">
                                @NmNotificador
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Setor</div>
                            <div class="text-secondary">
                                @DsSetor
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Paciente</div>
                            <div class="text-secondary">
                                @NmPaciente
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Médico</div>
                            <div class="text-secondary">
                                @DsMedico
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Tipo de Incidente</div>
                            <div class="text-secondary">
                                @DsIncidente
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Fato</div>
                            <div class="text-secondary">
                                @notificacao.DsFato
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Consequências para</div>
                            <div class="text-secondary">
                                @notificacao.DsConsequencias
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Consequências</div>
                            <div class="text-secondary">
                                @notificacao.DsConsequenciasImediatas
                            </div>
                        </li>
                        <li>
                            <div class="h4 m-0">Ação Imediata</div>
                            <div class="text-secondary">
                                @notificacao.DsAcoesImediatas
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="card mt-2" style="height: calc((100vh - 300px) / 2); overflow: auto;">
                <div class="card-body">
                    <h4>Etapa</h4>
                    <ul class="steps steps-vertical">
                        @if (ieEtapas.IeClassProt)
                        {
                            <li class="step-item">
                                <div class="h4 m-0">Classificação do Incidente e Protocolo de segurança</div>
                                <small class="form-hint">
                                    Nessa etapa iremos preencher a <b>classificação do incidente</b> que é a categorização
                                    que define a gravidade e o impacto do incidente de segurança, ajudando a priorizar a resposta adequada e também
                                    o <b>protocolo de segurança</b> que são as diretrizes e procedimentos pré-definidos para lidar com incidentes de segurança,
                                    garantindo uma resposta rápida e eficaz para mitigar danos e proteger sistemas e dados.
                                </small>
                            </li>
                        }
                        else if (ieEtapas.IeDiagramas)
                        {
                            <li class="step-item">
                                <div class="h4 m-0">Diagramas</div>
                                <small class="form-hint">
                                    Nessa etapa iremos criar os diagramas que são representações visuais que podem incluir a topologia
                                    de rede, layouts de infraestrutura física, ou fluxogramas de processos relevantes ao incidente. Eles ajudam a visualizar o
                                    contexto e a interconectividade dos sistemas envolvidos.
                                </small>
                            </li>
                        }
                        else if (ieEtapas.IePlanosAcao)
                        {
                            <li class="step-item">
                                <div class="h4 m-0">Planos de Ação</div>
                                <small class="form-hint">
                                    Os planos de ação são conjuntos de medidas específicas a serem executadas para mitigar os efeitos do
                                    incidente e restaurar a operação normal. Isso pode incluir a remediação de vulnerabilidades, restauração de backups, ou
                                    implementação de controles adicionais.
                                </small>
                            </li>
                        }
                        else if (ieEtapas.IeAvaliacao)
                        {
                            <li class="step-item">
                                <div class="h4 m-0">Avaliação de Eficácia</div>
                                <small class="form-hint">
                                    A avaliação de eficácia refere-se à revisão do incidente após a implementação dos planos de ação para determinar se as medidas
                                    adotadas foram bem-sucedidas em mitigar o incidente e proteger contra futuras ocorrências similares.
                                </small>
                            </li>
                        }
                        else
                        {
                            <div style="justify-content: center;">
                                <div class="container-tight py-4">
                                    <div class="empty">
                                        <p class="empty-title">Selecione uma Etapa</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="card" style="height: calc(100vh - 242px);">
                <div class="card-header">
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="btn-etapas" id="btn-etapas-1" checked="@ieEtapas.IeClassProt" autocomplete="off" @onclick="@((e) => {ieEtapas.Check(!ieEtapas.IeClassProt, "IeClassProt", null, null);})">
                        <label for="btn-etapas-1" type="button" class="btn @ieDisponibilidade.DsSucessoClassProt">Classificação do Incidente e Protocolo de segurança</label>
                        <input type="radio" class="btn-check" disabled="@ieDisponibilidade.IeDiagramas" name="btn-etapas" id="btn-etapas-2" autocomplete="off" @onclick="@((e) => {ieEtapas.Check(!ieEtapas.IeDiagramas, "IeDiagramas", null, null);})">
                        <label for="btn-etapas-2" type="button" class="btn @ieDisponibilidade.DsSucessoDiagramas">Diagramas</label>
                        <input type="radio" class="btn-check" disabled="@ieDisponibilidade.IePlanosAcao" name="btn-etapas" id="btn-etapas-3" autocomplete="off" @onclick="@((e) => {ieEtapas.Check(!ieEtapas.IePlanosAcao, "IePlanosAcao", null, null);})">
                        <label for="btn-etapas-3" type="button" class="btn @ieDisponibilidade.DsSucessoPlanosAcao">Planos de Ação</label>
                        <input type="radio" class="btn-check" disabled="@ieDisponibilidade.IeAvaliacao" name="btn-etapas" id="btn-etapas-4" autocomplete="off" @onclick="@((e) => {ieEtapas.Check(!ieEtapas.IeAvaliacao, "IeAvaliacao", null, null);})">
                        <label for="btn-etapas-4" type="button" class="btn @ieDisponibilidade.DsSucessoAvaliacao">Avaliação de Eficácia</label>
                    </div>
                </div>
                <div class="card-body" style="overflow: auto;">
                    @if (ieEtapas.IeClassProt)
                    {
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="mb-3">
                                    <div class="form-label">Classificação do Incidente</div>
                                    <select class="form-select" value="@notificacao.Gravidade" disabled="" @oninput="@((e) => {notificacao.Gravidade = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})">
                                        <option value=""></option>
                                        <option value="Circunstância Notificável">Circunstância Notificável</option>
                                        <option value="Evento Adverso">Evento Adverso</option>
                                        <option value="Near Miss">Near Miss</option>
                                        <option value="Incidente sem dano">Incidente sem dano</option>
                                        <option value="Não Clínico">Não Clínico</option>
                                    </select>
                                </div>
                                @if (notificacao.Gravidade == "Evento Adverso")
                                {
                                    <div class="mt-3">
                                        <label class="form-label">
                                            Gravidade
                                            <small class="form-hint">
                                                Fonte: Ministério da Saúde
                                            </small>
                                        </label>

                                        <div>
                                            <label class="form-check mt-3">
                                                <input class="form-check-input" type="radio" disabled="" name="radios" checked="@(notificacao.DsGravidades == "Leve")" value="Leve" @onchange=@(__e => {notificacao.DsGravidades = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Leve <span class="badge bg-green ms-auto"></span>
                                                    <small class="form-hint">
                                                        Sintomas leves, danos mínimos ou moderados, duração rápida e apenas
                                                        intervenções mínimas. Ex. Observação extra, Revisão de tratamento, etc...
                                                    </small>
                                                </span>
                                            </label>
                                            <label class="form-check mt-3">
                                                <input class="form-check-input" type="radio" disabled="" name="radios" checked="@(notificacao.DsGravidades == "Moderado")" value="Moderado" @onchange=@(__e => {notificacao.DsGravidades = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Moderado <span class="badge bg-yellow ms-auto"></span>
                                                    <small class="form-hint">
                                                        Paciente sintomático, com necessidade de intervenção, com aumento de tempo
                                                        de intervenção, com dano ou perda de função permanente ou de longo prazo.
                                                        Ex. Procedimento terapêutico, Tratamento.
                                                    </small>
                                                </span>
                                            </label>
                                            <label class="form-check mt-3">
                                                <input class="form-check-input" type="radio" disabled="" name="radios" checked="@(notificacao.DsGravidades == "Grave")" value="Grave" @onchange=@(__e => {notificacao.DsGravidades = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Grave <span class="badge bg-orange ms-auto"></span>
                                                    <small class="form-hint">
                                                        Paciente sintomático, com necessidade de intervenção para suporte de vida, intervenção clínica/cirúrgica
                                                        de grande porte, causando diminuição da expectativa de vida, com grande dano ou perda de função permanente ou de longo prazo.
                                                    </small>
                                                </span>
                                            </label>
                                            <label class="form-check mt-3">
                                                <input class="form-check-input" type="radio" disabled="" name="radios" checked="@(notificacao.DsGravidades == "Óbito")" value="Óbito" @onchange=@(__e => {notificacao.DsGravidades = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Óbito <span class="badge bg-red ms-auto"></span>
                                                    <small class="form-hint">
                                                        Dentro das possibilidades, em curto prazo o evento causou ou acelerou a morte.
                                                    </small>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-xl-6">
                                <div class="mb-3">
                                    <div class="form-label">Protocolo de Segurança</div>
                                    <select class="form-select" disabled="" value="@notificacao.DsProtocoloSeguranca" @oninput="@((e) => {notificacao.DsProtocoloSeguranca = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})">
                                        <option value=""></option>
                                        <option value="Intercorrência">Intercorrência</option>
                                        <option value="Identificação do Paciente">Identificação do Paciente</option>
                                        <option value="Comunicação entre profissionais">Comunicação entre profissionais</option>
                                        <option value="Cadeia Medicamentosa">Cadeia Medicamentosa</option>
                                        <option value="Higiene de mãos">Higiene de mãos</option>
                                        <option value="Risco de Queda">Risco de Queda</option>
                                        <option value="Erro de Processo">Erro de Processo</option>
                                        <option value="Iras">Iras</option>
                                    </select>
                                </div>
                                @if (notificacao.DsProtocoloSeguranca == "Cadeia Medicamentosa")
                                {
                                    <div class="mt-3">
                                        <label class="form-label">
                                            Evento Relacionado
                                        </label>
                                        <div>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" disabled="" name="radios-evento" value="Farmacovigilância" checked="@(notificacao.DsEventoRelacao == "Farmacovigilância")" @onchange=@(__e => {notificacao.DsEventoRelacao = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <label class="form-check-label">
                                                    Farmacovigilância <span class=" bg-green ms-auto"></span>
                                                </label>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" disabled="" name="radios-evento" value="Tecnovigilância" checked="@(notificacao.DsEventoRelacao == "Tecnovigilância")" @onchange=@(__e => {notificacao.DsEventoRelacao = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Tecnovigilância <span class=" bg-yellow ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" disabled="" name="radios-evento" value="Hemovigilância" checked="@(notificacao.DsEventoRelacao == "Hemovigilância")" @onchange=@(__e => {notificacao.DsEventoRelacao = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Hemovigilância <span class=" bg-orange ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" disabled="" name="radios-evento" value="Protocolo" checked="@(notificacao.DsEventoRelacao == "Protocolo")" @onchange=@(__e => {notificacao.DsEventoRelacao = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Protocolo <span class=" bg-red ms-auto"></span>
                                                    <small class="form-hint">
                                                        <input class="form-control" type="text" disabled="" value="@notificacao.DsJustificativaRelacionada" @oninput="@((e) => {notificacao.DsJustificativaRelacionada = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})" placeholder="Qual?">
                                                    </small>
                                                </span>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <label class="form-label">
                                            Informações
                                        </label>
                                        <div>
                                            <label class="form-check">
                                                <label class="form-check-label">
                                                    Produto
                                                </label>
                                                <input class="form-control" type="text" disabled="" value="@notificacao.DsProdutoRelacao" @oninput="@((e) => {notificacao.DsProdutoRelacao = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})">
                                            </label>
                                            <label class="form-check">
                                                <label class="form-check-label">
                                                    Série/Lote
                                                </label>
                                                <input class="form-control" type="text" disabled="" value="@notificacao.NrLote" @oninput="@((e) => {notificacao.NrLote = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})">
                                            </label>
                                            <label class="form-check">
                                                <label class="form-check-label">
                                                    Reg. Anvisa
                                                </label>
                                                <input class="form-control" type="text" disabled="" value="@notificacao.NrRegistroAnvisa" @oninput="@((e) => {notificacao.NrRegistroAnvisa = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})">
                                            </label>
                                            <label class="form-check">
                                                <label class="form-check-label">
                                                    Fornecedor
                                                </label>
                                                <input class="form-control" type="text" disabled="" value="@notificacao.DsFornecedor" @oninput="@((e) => {notificacao.DsFornecedor = e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})">
                                            </label>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <div>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Hemoderivados/Hemocomponentes" checked="@(notificacao.DsRelacaoOpcional == "Hemoderivados/Hemocomponentes")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Hemoderivados/Hemocomponentes <span class=" bg-green ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Equipamentos médicos" checked="@(notificacao.DsRelacaoOpcional == "Equipamentos médicos")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Equipamentos médicos <span class=" bg-yellow ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Gases / Oxigênio" checked="@(notificacao.DsRelacaoOpcional == "Gases / Oxigênio")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Gases / Oxigênio <span class=" bg-orange ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Nutrição" checked="@(notificacao.DsRelacaoOpcional == "Nutrição")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Nutrição <span class=" bg-red ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Processo Clínico / Procedimentos" checked="@(notificacao.DsRelacaoOpcional == "Processo Clínico / Procedimentos")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Processo Clínico / Procedimentos <span class=" bg-red ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Estrutura" checked="@(notificacao.DsRelacaoOpcional == "Estrutura")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Estrutura <span class=" bg-red ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Gerenciamento de Risco / Ocupacionais" checked="@(notificacao.DsRelacaoOpcional == "Gerenciamento de Risco / Ocupacionais")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Gerenciamento de Risco / Ocupacionais <span class=" bg-red ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Material Médico Hospitalar" checked="@(notificacao.DsRelacaoOpcional == "Material Médico Hospitalar")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Material Médico Hospitalar <span class=" bg-red ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="radios-relacao" disabled="" value="Infecção" checked="@(notificacao.DsRelacaoOpcional == "Infecção")" @onchange=@(__e => {notificacao.DsRelacaoOpcional = __e.Value.ToString(); ieDisponibilidade.ChecarDisponibilidade(!ieDisponibilidade.IeDiagramas, "IeDiagramas", null);})>
                                                <span class="form-check-label">
                                                    Infecção <span class=" bg-red ms-auto"></span>
                                                </span>
                                            </label>
                                            <label class="form-check">
