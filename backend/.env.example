JWT_SECRET=be5662u45e*ue50u651$#%bjk46u60bjue*b0ue3j1dtjbd6ys3w04t923am
TOKEN_EXPIRES_IN=2h
# Administrators manage operational access in Configurações → Permissões.
PERMISSIONS_ENABLED=true
PORT=3005

# MySQL connection settings Local/Dev
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=realmed

#MySQL connection settings Prod
DB_HOST=
DB_PORT=33060
DB_USER=root
DB_PASS=
DB_NAME=realmed

# Stenci
STENCI_ENABLED=true
STENCI_API_X_BASE_URL=https://api-x.stenci.pro
STENCI_API_BASE_URL=https://api.stenci.pro
# Identificador obrigatório da instalação Realmed (as credenciais vêm da tela de login)
STENCI_BRANCH_ID=
STENCI_TIMEOUT_MS=10000
STENCI_ORIGIN=https://stenci.app
STENCI_REFERER=https://stenci.app/
STENCI_USER_AGENT=

# Modo fisioterapeuta: conta Stenci compartilhada configurada como secret no servidor.
# Nunca configure esses valores no frontend nem os registre em logs.
STENCI_FISIO_USERNAME=
STENCI_FISIO_PASSWORD=
# Somente desenvolvimento local: permite testar reconhecimento e montar as telas sem Stenci.
STENCI_FISIO_DEV_BYPASS=false
# Produção exige a segunda confirmação explícita para habilitar o modo acima temporariamente.
STENCI_FISIO_DEV_BYPASS_IN_PRODUCTION=false

# Gere uma chave aleatória de 32 bytes em Base64; preserve-a para ler os modelos já cadastrados.
REALMED_BIOMETRY_KEY=
